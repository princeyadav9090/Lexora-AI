generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  cognitoSub    String?        @unique
  name          String
  role          String         @default("USER") // USER, LAWYER, ADMIN
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documents     Document[]
  conversations Conversation[]
  consultations Consultation[] @relation("UserConsultations")
  lawyerProfile LawyerProfile?
  auditLogs     AuditLog[]
}

model LawyerProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  specialization String
  experience     Int
  languages      String
  location       String
  fee            Float
  rating         Float          @default(4.9)
  bio            String
  isVerified     Boolean        @default(true)
  avatarUrl      String?
  consultations  Consultation[] @relation("LawyerConsultations")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Document {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  type           String            // NDA, RENTAL_AGREEMENT, EMPLOYMENT_CONTRACT, FREELANCE_AGREEMENT, INTERNSHIP_AGREEMENT, UPLOADED
  jurisdiction   String            @default("IN")
  status         String            @default("DRAFT") // DRAFT, PROCESSING, READY, SIGNED
  filePath       String?
  fileType       String?           // PDF, DOCX, TXT
  fileSize       Int?
  expiryDate     DateTime?
  currentVersion Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       DocumentVersion[]
  chunks         DocumentChunk[]
  conversations  Conversation[]
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        Int
  content        String
  structuredData String?  // JSON stringified answers
  createdById    String
  changeLog      String?
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  section    String?
  pageNumber Int?
  createdAt  DateTime @default(now())
}

model Conversation {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title       String
  contextMode String    @default("GENERAL") // GENERAL, DOCUMENT
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // USER, AI
  content        String
  explanation    String?
  relevantClause String?
  sourceCitation String?
  createdAt      DateTime     @default(now())
}

model Consultation {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation("UserConsultations", fields: [userId], references: [id], onDelete: Cascade)
  lawyerId  String
  lawyer    LawyerProfile @relation("LawyerConsultations", fields: [lawyerId], references: [id], onDelete: Cascade)
  date      String
  time      String
  issue     String
  status    String        @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  createdAt DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
