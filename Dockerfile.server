FROM node:18-slim

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install openssl for Prisma
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Install dependencies
RUN npm install

# Copy application files
COPY server/ ./server/

# Generate Prisma client
RUN npm run prisma:generate

# Expose port
EXPOSE 5000

# Start server
CMD ["npm", "run", "server"]
