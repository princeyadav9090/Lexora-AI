{
  "name": "lexora-ai",
  "version": "1.0.0",
  "description": "Lexora AI — Your Smart Legal Companion (Node.js + React MVP)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && cd client && npm install",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "prisma:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=server/prisma/schema.prisma",
    "prisma:seed": "node server/prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.650.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "^5.20.0"
  }
}
